# UhHu! — exemplo de ambiente DEV (COMMITADO, sem segredos reais).
#
# Copie para `.env.dev` (ignorado pelo Git, nunca commitado) e preencha:
#   cp .env.example .env.dev && chmod 600 .env.dev
#
# - `HOST` abaixo = IP/hostname tailnet da VPS onde o PG DEV roda (D-06).
# - `CHANGE_ME` = placeholder; troque por senhas reais SOMENTE no `.env.dev`.
# - Dev e prod usam bancos, credenciais e `.env` distintos (D-05/D-07).

NODE_ENV=development
APP_DATABASE_URL=postgresql://uhhu_app:CHANGE_ME@HOST:55432/uhhu_dev
MIGRATION_DATABASE_URL=postgresql://uhhu_migrate:CHANGE_ME@HOST:55432/uhhu_dev
PG_DEV_PASSWORD=
PORT=3000
LOG_LEVEL=info
